{
  "extends": "./tsconfig.base.json",
  "include": ["packages/*/src/**/*", "packages/*/scripts/**/*", "apps/*/src/**/*"],
  "exclude": ["**/node_modules", "**/dist", "**/*.generated.ts"],
  "compilerOptions": {
    "paths": {
      "@townsquare/manifest": ["./packages/manifest/src/index.ts"],
      "@townsquare/shared": ["./packages/shared/src/index.ts"],
      "@townsquare/tokens": ["./packages/tokens/src/index.ts"],
      "@townsquare/sdk": ["./packages/sdk/src/index.js"]
    },
    "baseUrl": "."
  }
}
