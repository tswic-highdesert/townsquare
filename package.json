{
  "name": "townsquare",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:setup": "node scripts/check-setup.mjs",
    "pretypecheck": "node scripts/check-setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ported.json",
    "pretest": "node scripts/check-setup.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/check-setup.mjs",
    "test:watch": "vitest",
    "predev": "node scripts/check-setup.mjs",
    "dev": "node scripts/dev.mjs",
    "predev:demo": "node scripts/check-setup.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "gen": "tsx packages/sdk/scripts/generate.ts",
    "gen:check": "tsx packages/sdk/scripts/generate.ts --check",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:sandbox": "tsx watch apps/sandbox/src/main.ts",
    "dev:mcp": "tsx watch apps/mcp/src/main.ts",
    "dev:web": "pnpm --filter @townsquare/web dev",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "railway": "3.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.0"
  }
}
